---
import Base from "../layouts/Base.astro";
import GuideList from "./GuideList.astro";
import { pageAlternates, type Lang, ui } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const [before, word, after] = t.heroTitle;
---

<Base lang={lang} alternates={pageAlternates("home")}>
  <section class="pt-10 pb-16">
    <h1 class="text-[26px] font-semibold leading-8 tracking-[-0.015em]">{before}{word}{after}</h1>
    <div class="mt-6 h-[2px] w-[90px] bg-ink" aria-hidden="true"></div>
    <p class="mt-5 max-w-md text-muted">{t.heroText}</p>
  </section>

  <section>
    <h2 class="text-[13px] leading-5 text-muted">01 · {t.guides}</h2>
    <div class="mt-4"><GuideList lang={lang} /></div>
  </section>
</Base>
