---
import { brandLink, type Brand } from "../lib/content";

interface Props {
  brand: Brand;
  label?: string;
}

const { brand, label = `Visit ${brand.name}` } = Astro.props;
const affiliate = Boolean(brand.affiliateUrl);
---

<p class="text-[13px]">
  <a
    href={brandLink(brand)}
    rel={affiliate ? "sponsored noopener" : "noopener"}
    target="_blank"
    class="inline-block border-b border-ink pb-0.5 hover:opacity-60"
  >{label} ↗</a>
  {affiliate && <span class="ml-2 text-muted">Affiliate link</span>}
</p>
