---
import Base from "../layouts/Base.astro";
import GuideList from "./GuideList.astro";
import { pageAlternates, ui, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} title={t.guidesTitle} description={t.guidesDescription} alternates={pageAlternates("guides")} crumbs={[{ label: t.guides }]}>
  <h1 class="pt-6 text-[26px] font-semibold leading-8 tracking-[-0.015em]">{t.guidesTitle}</h1>
  <div class="mt-6 h-[3px] w-[48px] rounded-full bg-ink" aria-hidden="true"></div>
  <div class="mt-8"><GuideList lang={lang} /></div>
</Base>
