---
import Base from "../layouts/Base.astro";
import { formatDate, getGuide, guideAlternates, guidePath, paths, store, ui, type Guide, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  guide: Guide;
}

const { lang, guide } = Astro.props;
const t = ui[lang];
const related = guide.related.flatMap((id) => getGuide(lang, id) ?? []);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: guide.question,
  description: guide.summary,
  inLanguage: lang === "en" ? "en-US" : "fr-FR",
  dateModified: guide.updatedOn,
  step: guide.steps.map((step, index) => ({ "@type": "HowToStep", position: index + 1, name: step.title, text: step.text })),
};
---

<Base
  lang={lang}
  title={guide.question}
  description={guide.summary}
  type="article"
  jsonLd={jsonLd}
  alternates={guideAlternates(guide.id)}
  crumbs={[{ label: t.guides, href: paths.guides[lang] }, { label: guide.question }]}
>
  <article class="pt-6">
    <p class="text-[13px] leading-5 text-muted">{t.guideLabel} · {t.updated} {formatDate(lang, guide.updatedOn)}</p>
    <h1 class="mt-4 text-[26px] font-semibold leading-8 tracking-[-0.015em]">{guide.question}</h1>
    <div class="mt-6 h-[2px] w-[90px] bg-ink" aria-hidden="true"></div>
    <p class="mt-5 text-muted">{guide.intro}</p>

    {guide.verdict && <p class="mt-8 rounded-[6px] border border-line bg-white p-5 text-[15px] font-medium leading-6">{guide.verdict}</p>}

    <ol class="mt-12 space-y-10">
      {
        guide.steps.map((step, index) => (
          <li>
            <h2 class="text-[18px] font-semibold leading-[26px] tracking-[-0.01em]">
              <span class="mr-3 text-muted">{String(index + 1).padStart(2, "0")}</span>
              {step.title}
            </h2>
            <p class="mt-2">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <p aria-hidden="true" class="mt-16 text-center tracking-[1em] text-muted">···</p>

    <section class="mt-14">
      <h2 class="text-[13px] leading-5 text-muted">{t.pitfalls}</h2>
      <ul class="mt-4 space-y-2">
        {guide.pitfalls.map((pitfall) => <li class="flex gap-3 before:shrink-0 before:text-muted before:content-['—']">{pitfall}</li>)}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-[13px] leading-5 text-muted">{t.store}</h2>
      <p class="mt-4 flex flex-wrap items-baseline justify-between gap-3 border-t border-b border-line py-4">
        <span>{store.name}</span>
        <span class="text-[13px]">
          <a href={store.url} rel="sponsored noopener" target="_blank" class="border-b border-ink pb-0.5 hover:opacity-60">{t.visit} ↗</a>
          <span class="ml-2 text-muted">{t.affiliate}</span>
        </span>
      </p>
    </section>

    <section class="mt-14 text-[13px] text-muted">
      <h2 class="text-[13px] leading-5 text-muted">{t.sources}</h2>
      <ul class="mt-3 space-y-1">
        {guide.sources.map((source) => <li><a href={source.url} rel="noopener" target="_blank" class="underline underline-offset-4 hover:text-ink">{source.label}</a> <span aria-hidden="true">↗</span></li>)}
      </ul>
    </section>

    {
      related.length > 0 && (
        <section class="mt-14">
          <h2 class="text-[13px] leading-5 text-muted">{t.readNext}</h2>
          <ul class="mt-3 space-y-2">
            {related.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="text-muted">—</span><a href={guidePath(lang, item)} class="text-[15px] font-medium hover:opacity-60">{item.question}</a></li>)}
          </ul>
        </section>
      )
    }
  </article>
</Base>
