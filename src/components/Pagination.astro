---
// Previous · 2 / 72 · Next, as plain text links.
interface Props {
  page: number;
  total: number;
  href: (page: number) => string;
}

const { page, total, href } = Astro.props;
---

{
  total > 1 && (
    <nav aria-label="Pages" class="mt-16 flex items-baseline justify-center gap-4 border-t border-line pt-8 text-[13px] text-muted">
      {page > 1 ? <a href={href(page - 1)} rel="prev" class="underline underline-offset-4 hover:text-ink">Previous</a> : <span class="opacity-40">Previous</span>}
      <span aria-hidden="true">·</span>
      <span>{page} / {total}</span>
      <span aria-hidden="true">·</span>
      {page < total ? <a href={href(page + 1)} rel="next" class="underline underline-offset-4 hover:text-ink">Next</a> : <span class="opacity-40">Next</span>}
    </nav>
  )
}
