---
import "../styles/global.css";
import { langLabels, locales, paths, siteName, ui, type Lang } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  jsonLd?: object;
  lang?: Lang;
  // This page in each language (hreflang + language switch). Without it, the switch goes to each home page.
  alternates?: { lang: Lang; path: string }[];
  // Breadcrumb after « Home »; the last item is the current page (no href).
  crumbs?: { label: string; href?: string }[];
}

const { title, lang = "en", type = "website", jsonLd, alternates, crumbs = [] } = Astro.props;
const t = ui[lang];
const description = Astro.props.description ?? t.description;
const documentTitle = title ? `${title} · ${siteName}` : `${siteName} · ${t.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/brand/pieceworth-cover.png", Astro.site).href;
const siteLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: siteName, url: Astro.site?.href, logo: new URL("/brand/pieceworth-logo.png", Astro.site).href },
    { "@type": "WebSite", name: siteName, url: Astro.site?.href, inLanguage: ["en-US", "fr-FR"] },
  ],
};
const trail = crumbs.length ? [{ label: t.home, href: paths.home[lang] }, ...crumbs] : [];
const breadcrumbLd = trail.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: trail.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.label,
        item: new URL(crumb.href ?? Astro.url.pathname, Astro.site).href,
      })),
    }
  : undefined;
const nav = [
  { href: paths.guides[lang], label: t.guides },
  { href: paths.about[lang], label: t.about },
];
const switcher = (["en", "fr"] as const).map((code) => ({
  code,
  label: langLabels[code],
  href: alternates?.find((item) => item.lang === code)?.path ?? paths.home[code],
}));
---

<!doctype html>
<html lang={lang === "en" ? "en-US" : "fr-FR"} class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="p:domain_verify" content="0ca382e71697625e770f119a02a4d12b" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      alternates && [
        ...alternates.map((item) => <link rel="alternate" hreflang={item.lang === "en" ? "en-US" : "fr"} href={new URL(item.path, Astro.site)} />),
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((item) => item.lang === "en")?.path ?? "/", Astro.site)} />,
      ]
    }
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locales[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-paper font-sans text-[15px] leading-6 text-ink">
    <!-- Sticky header (Dário, 2026-10-04): stays at the top, black background, thin line once scrolled. -->
    <header data-sticky-header class="sticky top-0 z-40 border-b border-transparent bg-paper px-5 py-6 transition-colors duration-200 data-[scrolled]:border-surface-3 sm:px-8">
        <div class="flex items-center justify-between">
          <a href={paths.home[lang]} class="text-[15px] font-semibold tracking-[-0.01em]">{siteName}</a>
          <button
            type="button"
            class="-my-1.5 flex h-10 w-10 items-center justify-center rounded-[8px] text-ink transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label="Menu"
            data-menu-button
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13" />
            </svg>
          </button>
        </div>
    </header>
    <script is:inline>
      // Sticky header: thin line at the bottom only once the page is scrolled.
      (function () {
        var header = document.querySelector("[data-sticky-header]");
        if (!header) return;
        var update = function () { header.toggleAttribute("data-scrolled", window.scrollY > 4); };
        update();
        window.addEventListener("scroll", update, { passive: true });
      })();
    </script>
    <!-- Spacer: keeps the page where it was before (the header used to have 60px of bottom padding). -->
    <div aria-hidden="true" class="h-9"></div>
    <!-- Side drawer: slides in from the right, full height, over a dimmed page. -->
    <div id="site-menu" hidden class="group/drawer fixed inset-0 z-50" data-menu-drawer>
      <div
        class="absolute inset-0 bg-black/60 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 ease-out group-data-[open]/drawer:opacity-100 motion-reduce:transition-none"
        aria-hidden="true"
        data-menu-backdrop
      ></div>
      <div
        role="dialog"
        aria-modal="true"
        aria-label="Menu"
        class="absolute inset-y-0 right-0 flex w-[85%] max-w-[360px] translate-x-full flex-col overflow-y-auto border-l border-surface-3 bg-paper px-5 pb-8 pt-6 shadow-[0_8px_32px_rgb(0_0_0/0.6)] transition-transform duration-300 ease-out group-data-[open]/drawer:translate-x-0 motion-reduce:transition-none sm:w-[320px] sm:px-8"
        data-menu-panel
      >
        <div class="flex justify-end">
          <button
            type="button"
            class="-my-1.5 flex h-10 w-10 items-center justify-center rounded-[8px] text-ink transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            aria-label={lang === "en" ? "Close menu" : "Fermer le menu"}
            data-menu-close
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M4 4l10 10M14 4L4 14" />
            </svg>
          </button>
        </div>
        <!-- Plain rows with thin separators and a › arrow (no grouped card). -->
        <nav class="mt-8 flex flex-col border-t border-surface-3 text-[17px] font-semibold leading-5 tracking-[-0.01em]">
          {nav.map((item) => <a href={item.href} class="group flex items-center justify-between border-b border-surface-3 py-3.5 pr-1">{item.label}<span aria-hidden="true" class="text-[20px] font-normal text-muted transition-[color,transform] duration-150 group-hover:translate-x-[3px] group-hover:text-ink group-focus-visible:translate-x-[3px] group-focus-visible:text-ink motion-reduce:transition-none">›</span></a>)}
        </nav>
        <nav aria-label="Language / Langue" class="mt-6 flex w-fit gap-5 text-[13px] font-semibold tracking-[0.04em]">
          {
            switcher.map((item) =>
              item.code === lang ? (
                <span aria-current="true" class="py-1.5 text-ink underline underline-offset-4">{item.label}</span>
              ) : (
                <a href={item.href} hreflang={item.code} class="py-1.5 text-muted hover:text-ink">{item.label}</a>
              ),
            )
          }
        </nav>
      </div>
    </div>
    <script>
      // Side drawer: button opens it; ✕, Esc, backdrop click and link click close it.
      // Focus goes into the drawer (and stays there) and back to the button; the page does not scroll while it is open.
      const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
      const drawer = document.querySelector<HTMLElement>("[data-menu-drawer]");
      if (button && drawer) {
        const panel = drawer.querySelector<HTMLElement>("[data-menu-panel]")!;
        const closeButton = drawer.querySelector<HTMLButtonElement>("[data-menu-close]")!;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let hideTimer: number | undefined;
        const isOpen = () => button.getAttribute("aria-expanded") === "true";
        const lockScroll = (lock: boolean) => {
          const root = document.documentElement;
          if (lock) {
            const scrollbar = window.innerWidth - root.clientWidth;
            root.style.overflow = "hidden";
            if (scrollbar > 0) document.body.style.paddingRight = `${scrollbar}px`;
          } else {
            root.style.overflow = "";
            document.body.style.paddingRight = "";
          }
        };
        const open = () => {
          window.clearTimeout(hideTimer);
          drawer.hidden = false;
          lockScroll(true);
          void drawer.offsetWidth; // start the slide from the closed position
          drawer.setAttribute("data-open", "");
          button.setAttribute("aria-expanded", "true");
          closeButton.focus({ preventScroll: true });
        };
        const close = () => {
          if (!isOpen()) return;
          drawer.removeAttribute("data-open");
          button.setAttribute("aria-expanded", "false");
          lockScroll(false);
          button.focus({ preventScroll: true });
          hideTimer = window.setTimeout(() => (drawer.hidden = true), reducedMotion.matches ? 0 : 300);
        };
        button.addEventListener("click", () => (isOpen() ? close() : open()));
        closeButton.addEventListener("click", close);
        drawer.querySelector("[data-menu-backdrop]")!.addEventListener("click", close);
        panel.addEventListener("click", (event) => {
          if ((event.target as Element).closest("a")) close();
        });
        document.addEventListener("keydown", (event) => {
          if (!isOpen()) return;
          if (event.key === "Escape") {
            event.preventDefault();
            close();
          } else if (event.key === "Tab") {
            const items = [...panel.querySelectorAll<HTMLElement>("a[href], button")];
            const first = items[0];
            const last = items[items.length - 1];
            if (event.shiftKey && (document.activeElement === first || !panel.contains(document.activeElement))) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && (document.activeElement === last || !panel.contains(document.activeElement))) {
              event.preventDefault();
              first.focus();
            }
          }
        });
      }
    </script>
    <div class="mx-auto w-full max-w-[580px] px-5 pt-16 min-[620px]:px-0">
      {
        trail.length > 0 && (
          <nav aria-label="Breadcrumb" class="mb-6 text-[13px] leading-5 text-muted">
            <ol class="flex flex-wrap gap-x-3">
              {trail.map((crumb, index) => (
                <li class="flex gap-3">
                  {index > 0 && <span aria-hidden="true" class="text-faint">·</span>}
                  {crumb.href ? <a href={crumb.href} class="underline decoration-line underline-offset-4 hover:text-ink hover:decoration-ink">{crumb.label}</a> : <span aria-current="page" class="text-ink">{crumb.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <main>
        <slot />
      </main>
      <footer class="mt-12 pb-16 text-[13px] leading-5 text-faint">
        <p class="mb-4">{t.footerLine}</p>
        <p>
          {t.footer} <a href={paths.disclosure[lang]} class="underline underline-offset-4">{t.disclosure}</a>.
        </p>
        <p class="mt-3">{t.footerCheck}</p>
      </footer>
    </div>
    <!-- Sovrn Commerce (VigLink): turns plain store links into affiliate links. -->
    <script is:inline type="text/javascript">
      var vglnk = { key: "eeecc81303b8b1a155bd9a7197759987" };
      (function (d, t) {
        var s = d.createElement(t);
        s.type = "text/javascript";
        s.async = true;
        s.src = "//cdn.viglink.com/api/vglnk.js";
        var r = d.getElementsByTagName(t)[0];
        r.parentNode.insertBefore(s, r);
      })(document, "script");
    </script>
  </body>
</html>
