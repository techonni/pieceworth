---
import "../styles/global.css";
import { siteName, tagline } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  jsonLd?: object;
  // Breadcrumb after « Home »; the last item is the current page (no href).
  crumbs?: { label: string; href?: string }[];
}

const { title, description = tagline, type = "website", jsonLd, crumbs = [] } = Astro.props;
const documentTitle = title ? `${title} · ${siteName}` : `${siteName} · Buy luxury wisely`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/brand/pieceworth-cover.png", Astro.site).href;
const siteLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: siteName, url: Astro.site?.href, logo: new URL("/brand/pieceworth-logo.png", Astro.site).href },
    { "@type": "WebSite", name: siteName, url: Astro.site?.href },
  ],
};
const trail = crumbs.length ? [{ label: "Home", href: "/" }, ...crumbs] : [];
const breadcrumbLd = trail.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: trail.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.label,
        item: new URL(crumb.href ?? Astro.url.pathname, Astro.site).href,
      })),
    }
  : undefined;
const nav = [
  { href: "/shop/", label: "Shop" },
  { href: "/guides/", label: "Guides" },
  { href: "/picks/new-designer-bags-on-sale/", label: "Picks" },
  { href: "/stores/", label: "Stores" },
  { href: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="impact-site-verification" value="6a85da6e-2787-4a4e-af94-af2a62cebaec" />
    <meta name="p:domain_verify" content="0ca382e71697625e770f119a02a4d12b" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-paper font-sans text-[15px] leading-7 text-ink">
    <div class="mx-auto max-w-2xl px-5 sm:px-6">
      <header class="flex items-baseline justify-between py-8">
        <a href="/" class="font-serif text-2xl tracking-wide">{siteName}</a>
        <nav class="flex gap-3 text-[13px] text-muted">
          {nav.map((item, index) => <>{index > 0 && <span aria-hidden="true" class="text-muted/50">·</span>}<a href={item.href} class="hover:text-ink">{item.label}</a></>)}
        </nav>
      </header>
      {
        trail.length > 0 && (
          <nav aria-label="Breadcrumb" class="text-[12px] text-muted">
            <ol class="flex flex-wrap gap-x-3">
              {trail.map((crumb, index) => (
                <li class="flex gap-3">
                  {index > 0 && <span aria-hidden="true" class="text-muted/50">·</span>}
                  {crumb.href ? <a href={crumb.href} class="hover:text-ink">{crumb.label}</a> : <span aria-current="page" class="text-ink">{crumb.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <main class="pb-24">
        <slot />
      </main>
      <footer class="border-t border-line py-10 text-[12px] leading-6 text-muted">
        <p class="mb-4 uppercase tracking-[0.18em]">Pieceworth · Buy luxury wisely</p>
        <p>
          Pieceworth is an independent site. Some links are affiliate links: if you buy through them, we may earn a
          commission at no extra cost to you. <a href="/affiliate-disclosure/" class="underline underline-offset-4">Affiliate disclosure</a>.
        </p>
        <p class="mt-3">Always check prices, delivery and return rules on the store's own site before you buy.</p>
      </footer>
    </div>
  </body>
</html>
