---
import "../styles/global.css";
import { langLabels, locales, paths, siteName, ui, type Lang } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  jsonLd?: object;
  lang?: Lang;
  // This page in each language (hreflang + language switch). Without it, the switch goes to each home page.
  alternates?: { lang: Lang; path: string }[];
  // Breadcrumb after « Home »; the last item is the current page (no href).
  crumbs?: { label: string; href?: string }[];
}

const { title, lang = "en", type = "website", jsonLd, alternates, crumbs = [] } = Astro.props;
const t = ui[lang];
const description = Astro.props.description ?? t.description;
const documentTitle = title ? `${title} · ${siteName}` : `${siteName} · ${t.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/brand/pieceworth-cover.png", Astro.site).href;
const siteLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: siteName, url: Astro.site?.href, logo: new URL("/brand/pieceworth-logo.png", Astro.site).href },
    { "@type": "WebSite", name: siteName, url: Astro.site?.href, inLanguage: ["en-US", "fr-FR"] },
  ],
};
const trail = crumbs.length ? [{ label: t.home, href: paths.home[lang] }, ...crumbs] : [];
const breadcrumbLd = trail.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: trail.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.label,
        item: new URL(crumb.href ?? Astro.url.pathname, Astro.site).href,
      })),
    }
  : undefined;
const nav = [
  { href: paths.guides[lang], label: t.guides },
  { href: paths.about[lang], label: t.about },
];
const switcher = (["en", "fr"] as const).map((code) => ({
  code,
  label: langLabels[code],
  href: alternates?.find((item) => item.lang === code)?.path ?? paths.home[code],
}));
---

<!doctype html>
<html lang={lang === "en" ? "en-US" : "fr-FR"} class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="p:domain_verify" content="0ca382e71697625e770f119a02a4d12b" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      alternates && [
        ...alternates.map((item) => <link rel="alternate" hreflang={item.lang === "en" ? "en-US" : "fr"} href={new URL(item.path, Astro.site)} />),
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((item) => item.lang === "en")?.path ?? "/", Astro.site)} />,
      ]
    }
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locales[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-paper font-sans text-[15px] leading-6 text-ink">
    <!-- Bottom padding keeps the page where it was before the language row moved into the menu. -->
    <header class="px-5 pb-[60px] pt-6 sm:px-8">
        <div class="flex items-center justify-between">
          <a href={paths.home[lang]} class="text-[15px] font-semibold tracking-[-0.01em]">{siteName}</a>
          <div class="relative" data-menu>
            <button
              type="button"
              class="group -my-1.5 -mr-2 flex h-9 w-9 items-center justify-center rounded-md text-ink hover:bg-black/[0.04] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
              aria-expanded="false"
              aria-controls="site-menu"
              aria-label="Menu"
              data-menu-button
            >
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13" class="group-aria-expanded:hidden" />
                <path d="M4 4l10 10M14 4L4 14" class="hidden group-aria-expanded:block" />
              </svg>
            </button>
            <div
              id="site-menu"
              hidden
              class="absolute right-0 top-full z-40 mt-2 w-56 rounded-md border border-line bg-white p-2 shadow-[0_8px_24px_rgba(0,0,0,0.06)]"
              data-menu-panel
            >
              <nav class="flex flex-col text-[15px] font-semibold leading-5 tracking-[-0.01em]">
                {nav.map((item) => <a href={item.href} class="rounded px-3 py-2 hover:bg-[#f5f5f5]">{item.label}</a>)}
              </nav>
              <nav aria-label="Language / Langue" class="mt-2 flex gap-3 border-t border-line px-3 pb-1 pt-3 text-[12px] font-medium tracking-[0.04em]">
                {
                  switcher.map((item) =>
                    item.code === lang ? (
                      <span aria-current="true" class="text-ink">{item.label}</span>
                    ) : (
                      <a href={item.href} hreflang={item.code} class="text-muted/60 hover:text-ink">{item.label}</a>
                    ),
                  )
                }
              </nav>
            </div>
          </div>
        </div>
    </header>
    <script>
      // Header menu: toggle, Esc, outside click, link click and focus leaving the menu close it.
      document.querySelectorAll<HTMLElement>("[data-menu]").forEach((root) => {
        const button = root.querySelector<HTMLButtonElement>("[data-menu-button]")!;
        const panel = root.querySelector<HTMLElement>("[data-menu-panel]")!;
        const isOpen = () => button.getAttribute("aria-expanded") === "true";
        const setOpen = (open: boolean) => {
          button.setAttribute("aria-expanded", String(open));
          panel.hidden = !open;
        };
        button.addEventListener("click", () => setOpen(!isOpen()));
        panel.addEventListener("click", (event) => {
          if ((event.target as Element).closest("a")) setOpen(false);
        });
        document.addEventListener("click", (event) => {
          if (isOpen() && !root.contains(event.target as Node)) setOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && isOpen()) {
            setOpen(false);
            button.focus();
          }
        });
        root.addEventListener("focusout", (event) => {
          const next = event.relatedTarget as Node | null;
          if (next && !root.contains(next)) setOpen(false);
        });
      });
    </script>
    <div class="mx-auto w-full max-w-[580px] px-5 pt-16 min-[620px]:px-0">
      {
        trail.length > 0 && (
          <nav aria-label="Breadcrumb" class="mb-6 text-[13px] leading-5 text-muted">
            <ol class="flex flex-wrap gap-x-3">
              {trail.map((crumb, index) => (
                <li class="flex gap-3">
                  {index > 0 && <span aria-hidden="true" class="text-muted/50">·</span>}
                  {crumb.href ? <a href={crumb.href} class="hover:text-ink">{crumb.label}</a> : <span aria-current="page" class="text-ink">{crumb.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <main>
        <slot />
      </main>
      <footer class="mt-12 pb-16 text-[13px] leading-5 text-[#a0a0a0]">
        <p class="mb-4">{t.footerLine}</p>
        <p>
          {t.footer} <a href={paths.disclosure[lang]} class="underline underline-offset-4">{t.disclosure}</a>.
        </p>
        <p class="mt-3">{t.footerCheck}</p>
      </footer>
    </div>
    <!-- Sovrn Commerce (VigLink): turns plain store links into affiliate links. -->
    <script is:inline type="text/javascript">
      var vglnk = { key: "eeecc81303b8b1a155bd9a7197759987" };
      (function (d, t) {
        var s = d.createElement(t);
        s.type = "text/javascript";
        s.async = true;
        s.src = "//cdn.viglink.com/api/vglnk.js";
        var r = d.getElementsByTagName(t)[0];
        r.parentNode.insertBefore(s, r);
      })(document, "script");
    </script>
  </body>
</html>
