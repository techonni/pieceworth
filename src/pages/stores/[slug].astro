---
import Base from "../../layouts/Base.astro";
import StoreLink from "../../components/StoreLink.astro";
import { brands, formatDate, guides } from "../../lib/content";

export function getStaticPaths() {
  return brands.map((brand) => ({ params: { slug: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props;
const brandGuides = guides.filter((guide) => guide.brands.includes(brand.slug));
---

<Base title={`${brand.name}: what to know before you buy`} description={brand.summary} crumbs={[{ label: "Stores", href: "/stores/" }, { label: brand.name }]}>
  <p class="pt-6 text-[12px] uppercase tracking-[0.18em] text-muted">{brand.kind}</p>
  <h1 class="mt-4 font-serif text-[40px] leading-tight">{brand.name}</h1>
  <div class="mt-6 h-[2px] w-[90px] bg-ink" aria-hidden="true"></div>
  <p class="mt-4 text-muted">{brand.summary}</p>
  <div class="mt-6"><StoreLink brand={brand} subId={`store-${brand.slug}`} /></div>

  <dl class="mt-12 divide-y divide-line border-t border-b border-line">
    {
      brand.facts.map((fact) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-[13px] text-muted">{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-12 grid gap-10 sm:grid-cols-2">
    <section>
      <h2 class="text-[12px] uppercase tracking-[0.18em] text-muted">Good for</h2>
      <ul class="mt-3 space-y-2">{brand.goodFor.map((item) => <li class="flex gap-3 before:shrink-0 before:text-muted before:content-['—']">{item}</li>)}</ul>
    </section>
    <section>
      <h2 class="text-[12px] uppercase tracking-[0.18em] text-muted">Watch out</h2>
      <ul class="mt-3 space-y-2">{brand.watchOut.map((item) => <li class="flex gap-3 before:shrink-0 before:text-muted before:content-['—']">{item}</li>)}</ul>
    </section>
  </div>

  {
    brandGuides.length > 0 && (
      <section class="mt-14">
        <h2 class="text-[12px] uppercase tracking-[0.18em] text-muted">Guides</h2>
        <ul class="mt-3 space-y-2">
          {brandGuides.map((guide) => <li class="flex gap-3"><span aria-hidden="true" class="text-muted">—</span><a href={`/guides/${guide.slug}/`} class="font-serif text-[20px] hover:opacity-60">{guide.question}</a></li>)}
        </ul>
      </section>
    )
  }

  <p class="mt-14 text-[13px] text-muted">
    Checked on {formatDate(brand.checkedOn)} on the store's official pages:
    {brand.sources.map((source, index) => (
      <>
        {index > 0 && ", "}
        <a href={source.url} rel="noopener" target="_blank" class="underline underline-offset-4 hover:text-ink">{source.label} ↗</a>
      </>
    ))}. Rules change: check them again before you buy.
  </p>
</Base>
