---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { brands, guides } from "../lib/content";
import { count, currency, featured, products } from "../lib/catalog";
---

<Base>
  <section class="pt-10 pb-16">
    <h1 class="font-serif text-[42px] leading-[1.1] sm:text-[52px]">Buy luxury <em class="italic">wisely</em>.</h1>
    <div class="mt-6 h-[2px] w-[90px] bg-ink" aria-hidden="true"></div>
    <p class="mt-5 max-w-md text-muted">
      Where to shop, what to check before paying, and whether the piece is worth it. Short, honest guides.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-[12px] uppercase tracking-[0.18em] text-muted">01 · This week</h2>
    <a href="/picks/new-designer-bags-on-sale/" class="mt-4 block border-t border-b border-line py-5 hover:opacity-60">
      <span class="font-serif text-[22px] leading-snug">Brand-new designer bags on sale this week</span>
      <span class="mt-1 block text-[13px] text-muted">Twelve unworn pieces with tags, reduced by at least 30%.</span>
    </a>
  </section>

  <section class="mb-16">
    <h2 class="text-[12px] uppercase tracking-[0.18em] text-muted">02 · Shop</h2>
    <ul class="mt-8 grid grid-cols-2 gap-x-5 gap-y-12 sm:grid-cols-3">
      {featured.map((item) => <li><ProductCard item={item} subId="home" currency={currency} /></li>)}
    </ul>
    <p class="mt-14 text-center">
      <a href="/shop/" class="font-serif text-[22px] underline decoration-1 underline-offset-[6px] hover:opacity-60">See the full catalog</a>
      <span class="mt-2 block text-[12px] uppercase tracking-[0.18em] text-muted">{count(products.length)} pieces · Bags · Wallets · Scarves · Hats</span>
    </p>
  </section>

  <section>
    <h2 class="text-[12px] uppercase tracking-[0.18em] text-muted">03 · Guides</h2>
    <ul class="mt-4 divide-y divide-line border-t border-b border-line">
      {
        guides.map((guide, index) => (
          <li>
            <a href={`/guides/${guide.slug}/`} class="flex gap-5 py-5 hover:opacity-60">
              <span class="w-5 shrink-0 pt-[9px] text-[12px] tracking-[0.18em] text-muted">{String(index + 1).padStart(2, "0")}</span>
              <span>
                <span class="font-serif text-[22px] leading-snug">{guide.question}</span>
                <span class="mt-1 block text-[13px] text-muted">{guide.summary}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16">
    <h2 class="text-[12px] uppercase tracking-[0.18em] text-muted">04 · Stores</h2>
    <ul class="mt-4 grid gap-x-8 sm:grid-cols-2">
      {
        brands.map((brand) => (
          <li class="border-b border-line">
            <a href={`/stores/${brand.slug}/`} class="flex items-baseline justify-between gap-4 py-4 hover:opacity-60">
              <span>{brand.name}</span>
              <span class="text-right text-[12px] text-muted">{brand.kind}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
