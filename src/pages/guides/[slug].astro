---
import GuidePage from "../../components/GuidePage.astro";
import { guides } from "../../lib/i18n";

export function getStaticPaths() {
  return guides.en.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
---

<GuidePage lang="en" guide={guide} />
